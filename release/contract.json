        "timeout_seconds": 10,
        "attempts": 2,
        "blocking": true
      },
      {
        "id": "unknown-path-404",
        "description": "An unknown path returns a real 404 and never a soft 200 or a redirect to the index.",
        "scope": "public",
        "method": "GET",
        "path": "/release-smoke-unknown-path",
