        "method": "GET",
        "path": "/market-structure/",
        "expect": {
          "status": 200,
          "no_external_origins": true,
          "body_excludes_patterns": [
            "<base[\\s>]"
          ]
        },
        "timeout_seconds": 10,
        "attempts": 2,
        "blocking": true
      },
      {
        "id": "security-headers",
        "description": "Application security header policy is present on HTML responses.",
        "scope": "public",
        "method": "GET",
        "path": "/",
        "expect": {
          "status": 200,
          "max_redirects": 2,
          "headers": [
            {
              "name": "X-Content-Type-Options",
              "match": "equals",
