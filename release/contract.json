        "attempts": 2,
        "blocking": true
      },
      {
        "id": "lesson-page",
        "description": "Market Structure lesson is served at the subpath and carries its title and risk disclaimer.",
        "scope": "public",
        "method": "GET",
        "path": "/market-structure/",
        "expect": {
          "status": 200,
          "max_redirects": 2,
          "same_origin_redirects_only": true,
          "body_contains": [
            "Market Structure Lab",
            "educational"
          ]
