            graphs-of-polynomial-functions; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=rational-and-radical-expressions; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 5 home)."; exit 1; }; \
    for lesson in rational-expressions-and-their-domains \
            simplifying-rational-expressions \
            multiplying-and-dividing-rational-expressions \
            adding-and-subtracting-rational-expressions \
            complex-fractions \
            solving-rational-equations \
            graphs-and-asymptotes \
            simplifying-radical-expressions \
            operations-with-radicals \
            rationalizing-denominators \
            solving-radical-equations \
            radical-functions-and-their-graphs; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=quadratics-and-complex-numbers; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 6 home)."; exit 1; }; \
    for lesson in quadratic-equations-and-the-zero-product-property \
            solving-by-factoring \
            the-square-root-property \
            completing-the-square \
            the-quadratic-formula \
            the-discriminant \
            complex-numbers \
            operations-with-complex-numbers \
            complex-roots-of-quadratics \
            graphs-of-quadratic-functions \
            vertex-form-and-the-axis-of-symmetry \
            maximum-and-minimum-problems \
            quadratic-inequalities \
            equations-reducible-to-quadratic-form; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=exponential-and-logarithmic-functions; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 7 home)."; exit 1; }; \
    for lesson in exponential-functions \
            growth-and-decay \
            the-number-e \
            what-a-logarithm-is \
            logarithmic-functions-and-their-graphs \
            the-laws-of-logarithms \
            common-and-natural-logarithms \
            change-of-base \
            solving-exponential-equations \
            solving-logarithmic-equations \
            compound-interest-and-continuous-growth \
            logarithmic-scales; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=systems-and-matrices; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 8 home)."; exit 1; }; \
    for lesson in systems-of-two-linear-equations \
            solving-by-substitution \
            solving-by-elimination \
            systems-in-three-variables \
            matrices-and-row-operations \
            gaussian-elimination \
            matrix-arithmetic \
            determinants-and-cramers-rule \
            inverse-matrices \
            systems-of-inequalities-and-linear-programming; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=sequences-and-series; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 9 home)."; exit 1; }; \
    for lesson in sequences-and-recursion \
            sigma-notation \
            arithmetic-sequences-and-series \
            geometric-sequences-and-series \
            partial-sums-and-telescoping \
            infinite-geometric-series \
            repeating-decimals-as-series \
            annuities-and-accumulated-payments \
            pascals-triangle \
            the-binomial-theorem \
            the-general-term-of-an-expansion; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    test -f /srv/progress/index.html || { echo "FATAL: missing /srv/progress/index.html (the progress page). It is where a reader signs in to carry their completion marks between devices; every lesson links to it."; exit 1; }; \
    test -f /srv/oauth2/spa/callback/index.html || { echo "FATAL: missing /srv/oauth2/spa/callback/index.html (the Microsoft sign-in redirect target). Its absence breaks sign-in at the redirect step, after the reader has already authenticated."; exit 1; }; \
    test ! -e /srv/learn || { echo "FATAL: /srv/learn exists. 'learn' is the SUBDOMAIN, not a path segment: course 1 lesson 01 is published at learn.geterdone.io/market-structure/market-structure/, never learn.geterdone.io/learn/market-structure/market-structure/. Move site/learn/* up one level."; exit 1; }; \
    test ! -e /srv/market-structure-lab || { echo "FATAL: /srv/market-structure-lab exists. Course 1 was renamed to /market-structure; the old prefix must not be re-added, or the image would publish the same course at two URLs with one canonical between them."; exit 1; }; \
    test ! -e /srv/paths/index.html || { echo "FATAL: /srv/paths/index.html exists. The paths layer publishes one page per path (/paths/<subject>/) and nothing at /paths/ itself; the list of paths is the site index at /. Remove it or move it."; exit 1; }; \
    chmod -R a=rX /srv

FROM docker.io/library/caddy@sha256:f43d8810c944e27e6f7ea80b165de11dbdab16cff15c8a80d83ae3e1a109a35d

LABEL org.opencontainers.image.source="https://github.com/dmedellin/market-structure-lab" \
      org.opencontainers.image.revision="__GIT_REVISION__" \
      org.opencontainers.image.title="Market Structure Lab"

COPY --chmod=0644 deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=site /srv /srv

# Fail the build on a malformed or unrendered config instead of shipping an
# image that crash-loops on the host.
RUN caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile

# Drop the file capability the base image sets on the binary (cap_net_bind_service).
# The container runs unprivileged with cap_drop ALL + no-new-privileges and binds
# an unprivileged port only, so the capability is both useless and a liability.
RUN setcap -r /usr/bin/caddy

USER 1000:1000
EXPOSE __LOOPBACK_PORT__

# NOTE: `podman build` defaults to OCI image format, which DROPS HEALTHCHECK
# ("HEALTHCHECK is not supported for OCI image format and will be ignored").
# Build with `--format docker` if the image-level healthcheck is wanted. The
# authoritative liveness signal for the platform is the compose healthcheck in
# compose.template.yaml, which is what the deploy wrapper waits on; this line is
# a convenience for local runs and must not be relied on alone.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O- http://127.0.0.1:__LOOPBACK_PORT__/healthz || exit 1
