    course=polynomials-and-factoring; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 4 home)."; exit 1; }; \
    for lesson in polynomials-degree-and-standard-form \
            adding-and-subtracting-polynomials \
            multiplying-polynomials \
            special-products \
            factoring-out-the-greatest-common-factor \
            factoring-by-grouping \
            factoring-simple-trinomials \
            the-ac-method \
            factoring-special-forms \
            polynomial-long-division \
